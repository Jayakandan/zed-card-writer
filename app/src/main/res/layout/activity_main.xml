<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:background="@color/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/brand"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <View
                    android:id="@+id/pulseRing"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_pulse_ring"
                    android:alpha="0" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nfc"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1">

                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />
            </LinearLayout>

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:text="@string/logout_button"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="@color/text_on_brand"
                style="?android:borderlessButtonStyle" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Physical-card style panel: dark-to-red gradient, contactless icon
                     top-right, UID like a card number, name + balance on the bottom row. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_brand"
                    android:minHeight="190dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="18dp"
                        android:src="@drawable/ic_nfc"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <TextView
                            android:textSize="10sp"
                            android:textColor="@color/text_on_brand_dim"
                            android:letterSpacing="0.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_uid" />

                        <TextView
                            android:id="@+id/cardUidView"
                            android:textSize="19sp"
                            android:textColor="@color/text_on_brand"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08"
                            android:textIsSelectable="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/dash" />

                        <View
                            android:background="#22ffffff"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="26dp" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3">

                                <TextView
                                    android:textSize="10sp"
                                    android:textColor="@color/text_on_brand_dim"
                                    android:letterSpacing="0.14"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_cardholder" />

                                <TextView
                                    android:id="@+id/cardNameView"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_on_brand"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/dash" />
                            </LinearLayout>

                            <LinearLayout
                                android:orientation="vertical"
                                android:gravity="end"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">

                                <TextView
                                    android:textSize="10sp"
                                    android:textColor="@color/text_on_brand_dim"
                                    android:letterSpacing="0.14"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_balance" />

                                <TextView
                                    android:id="@+id/cardBalanceView"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/dash" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/statusView"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ok"
                    android:background="@drawable/bg_status_ok"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/status_initial" />

                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_name" />

                    <EditText
                        android:id="@+id/nameInput"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_field"
                        android:padding="12dp"
                        android:hint="@string/hint_name"
                        android:inputType="textPersonName"
                        android:maxLength="16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/label_amount" />

                    <EditText
                        android:id="@+id/amountInput"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_field"
                        android:padding="12dp"
                        android:hint="@string/hint_amount"
                        android:inputType="numberDecimal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/label_action" />

                    <!-- Push buttons, one active at a time (state tracked in code). -->
                    <Button
                        android:id="@+id/modeRead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_mode_selected"
                        android:text="@string/mode_read"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_brand"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/modeWrite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_mode_unselected"
                        android:text="@string/mode_write"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/modeTopUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:background="@drawable/bg_mode_unselected"
                        android:text="@string/mode_topup"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/warn_text"
                    android:background="@drawable/bg_hint"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/tap_hint" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- "Ready to scan" / busy overlay, shown while idle and while a tap is
         being processed - dismissable, purely for guidance. -->
    <FrameLayout
        android:id="@+id/scanOverlayScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/scanOverlay"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_scan_overlay"
            android:padding="28dp"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <View
                    android:id="@+id/scanPulse"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_pulse_ring"
                    android:alpha="0" />

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_scan_icon_circle"
                    android:padding="20dp"
                    android:src="@drawable/ic_nfc"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/scanTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/scan_ready_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scanSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/scan_ready_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/scanCancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="0dp"
                android:text="@string/scan_cancel"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                style="?android:borderlessButtonStyle" />
        </LinearLayout>
    </FrameLayout>

    <!-- Success / failure feedback, shown briefly over everything else. -->
    <ImageView
        android:id="@+id/resultIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:alpha="0"
        android:contentDescription="@null" />

</FrameLayout>
